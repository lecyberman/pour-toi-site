# ============================================================
#  Variables d'environnement — Pour toi
# ------------------------------------------------------------
#  Copie ce fichier en ".env" en local, et renseigne les mêmes
#  variables dans Vercel : Project Settings > Environment Variables.
#  NE JAMAIS committer de vraie clé. Ce fichier ne contient que des exemples vides.
# ============================================================

# --- Public (côté client) ---
# Utilisées si un jour on passe à un framework avec build (Astro/Next).
# Sur le site statique actuel, la clé anon reste dans supabase.js (OK car RLS strict).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Serveur uniquement (fonctions Vercel /api) ---
# NE JAMAIS exposer côté navigateur. Réservé à la lecture admin protégée.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
